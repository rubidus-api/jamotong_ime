// jamotong-cleanup.exe 리소스 — 아이콘, 관리자 권한 매니페스트, 버전 정보. 판은 version.h 에서 파생.
#include "version.h"
100 ICON "jamotong.ico"
1 24 "jamotong_cleanup.manifest"

1 VERSIONINFO
 FILEVERSION JAMOTONG_VERSION_MAJOR,JAMOTONG_VERSION_MINOR,JAMOTONG_VERSION_PATCH,0
 PRODUCTVERSION JAMOTONG_VERSION_MAJOR,JAMOTONG_VERSION_MINOR,JAMOTONG_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "rubidus-api"
            VALUE "FileDescription", "Jamotong Cleanup - removes every version of Jamotong"
            VALUE "FileVersion", JAMOTONG_VERSION_A
            VALUE "InternalName", "jamotong-cleanup"
            VALUE "LegalCopyright", "(c) rubidus-api. MIT License."
            VALUE "OriginalFilename", "jamotong-cleanup.exe"
            VALUE "ProductName", "Jamotong IME"
            VALUE "ProductVersion", JAMOTONG_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
