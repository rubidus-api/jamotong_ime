// Jamotong 관리자 앱(jamotong.exe) 리소스 — 창 아이콘 + 버전 정보 (RFC-0008 W2-08).
// 판 숫자는 src/jamotong.rc 와 함께 올린다(릴리스 절차: src/*.rc 둘 다).
100 ICON "jamotong.ico"

1 VERSIONINFO
 FILEVERSION 0,27,0,0
 PRODUCTVERSION 0,27,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "rubidus-api"
            VALUE "FileDescription", "Jamotong Manager"
            VALUE "FileVersion", "0.27.0"
            VALUE "InternalName", "jamotong"
            VALUE "LegalCopyright", "(c) rubidus-api. MIT License."
            VALUE "OriginalFilename", "jamotong.exe"
            VALUE "ProductName", "Jamotong IME"
            VALUE "ProductVersion", "0.27.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
