// Jamotong 리소스: 프로파일 아이콘(Win11 트레이 입력표시기/언어전환창, 정적 "자모통").
// 리소스 ID 100 → RegisterProfile에 iconIndex=-100(음수=리소스ID) 전달. (-1은 특수값이라 회피)
#include "version.h"   // 판은 version.h 에서 파생 — 여기서 고치지 않는다
100 ICON "jamotong.ico"

// 버전 리소스(RT_VERSION) — MSI 가 이 판으로 덮어쓰기를 정한다.
1 VERSIONINFO
 FILEVERSION JAMOTONG_VERSION_MAJOR,JAMOTONG_VERSION_MINOR,JAMOTONG_VERSION_PATCH,0
 PRODUCTVERSION JAMOTONG_VERSION_MAJOR,JAMOTONG_VERSION_MINOR,JAMOTONG_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "rubidus-api"
            VALUE "FileDescription", "Jamotong Korean IME"
            VALUE "FileVersion", JAMOTONG_VERSION_A
            VALUE "InternalName", "jamotong"
            VALUE "LegalCopyright", "(c) rubidus-api. MIT License."
#if defined(JAMOTONG_X86)
            VALUE "OriginalFilename", "jamotong32.dll"
#else
            VALUE "OriginalFilename", "jamotong.dll"
#endif
            VALUE "ProductName", "Jamotong IME"
            VALUE "ProductVersion", JAMOTONG_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
